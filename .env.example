# Configurações opcionais de contato e integração do formulário (build-time)
# Também podem ser editadas diretamente em src/config/site.ts

# E-mail comercial exibido no rodapé e usado para fallback mailto
VITE_CONTACT_EMAIL=

# Número WhatsApp comercial apenas com DDI + DDD + número (ex: 5511999999999)
VITE_WHATSAPP_NUMBER=

# Endpoint HTTPS para envio real do formulário (ex: Supabase Edge Function, Formspree, API própria)
VITE_CONTACT_ENDPOINT=

# Caso utilize Supabase Edge Function diretamente:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
